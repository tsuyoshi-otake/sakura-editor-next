{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sakura-editor-next.invalid/schema/coverage-map-v1.json",
  "title": "Sakura Editor NEXT develop coverage map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_sha",
    "platform",
    "configuration",
    "runner_id",
    "test_binary_sha256",
    "inventory_guarantee_fingerprint",
    "test_count",
    "source_to_tests",
    "fragments"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "platform": { "type": "string", "minLength": 1 },
    "configuration": { "type": "string", "minLength": 1 },
    "runner_id": { "type": "string", "minLength": 1 },
    "test_binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "inventory_guarantee_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "test_count": { "type": "integer", "minimum": 1 },
    "source_to_tests": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector", "path", "sha256"],
        "properties": {
          "selector": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
