// 此文件包含资源编辑器无法编辑的元素。
// 这个文件的编码/换行代码是UTF-16LE(BOM)/CRLF。

#define _GSTR_APPNAME "Sakura Editor NEXT"
#define S_COPYRIGHT_FORK "Copyright (C) 2026 Tsuyoshi Otake"

#define S_COPYRIGHT "版权所有 (C) 1998-2022  Norio Nakatani 及贡献者"
#define S_COPYRIGHT_TRANSLATION "汉化版权 (C) 2011-2025 彭嘉宝"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUT DIALOG 0, 0, 336, 312
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "版本信息"
FONT 9, "Microsoft YaHei UI"
BEGIN
    ICON            IDI_ICON_STD, IDC_STATIC_MYICON, 16, 15, 28, 28, SS_NOTIFY
    LTEXT           "Sakura Editor NEXT", IDC_STATIC_ABOUT_NAME, 56, 14, 264, 18, NOT WS_GROUP
    LTEXT           "", IDC_STATIC_ABOUT_VERSION, 56, 36, 264, 13, NOT WS_GROUP
    LTEXT           "", IDC_EDIT_ABOUT, 16, 62, 304, 32, NOT WS_GROUP
    LTEXT           "构建信息", IDC_STATIC_ABOUT_BUILD_HEADING, 16, 102, 304, 11, NOT WS_GROUP
    EDITTEXT        IDC_EDIT_VER, 16, 116, 304, 42, ES_MULTILINE | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT           "链接", IDC_STATIC_ABOUT_LINKS_HEADING, 16, 166, 304, 11, NOT WS_GROUP
    LTEXT           "项目：", IDC_STATIC_URL_CAPTION, 16, 182, 68, 10, NOT WS_GROUP
    LTEXT           "https://github.com/tsuyoshi-otake/sakura-editor-next", IDC_STATIC_URL_UR, 88, 182, 232, 10, SS_NOTIFY | NOT WS_GROUP | WS_TABSTOP
#ifdef GIT_REMOTE_ORIGIN_URL
    LTEXT           "源代码：", IDC_STATIC_GIT_CAPTION, 16, 196, 68, 10, NOT WS_GROUP
    LTEXT           GIT_REMOTE_ORIGIN_URL, IDC_STATIC_URL_GIT, 88, 196, 232, 10, SS_NOTIFY | NOT WS_GROUP | WS_TABSTOP
#endif
#ifdef CI_BUILD_NUMBER_LABEL
    LTEXT           "构建：", IDC_STATIC_URL_CI_BUILD_CAPTION, 16, 210, 68, 10, NOT WS_GROUP
    LTEXT           CI_BUILD_NUMBER_LABEL, IDC_STATIC_URL_CI_BUILD, 88, 210, 232, 10, SS_NOTIFY | NOT WS_GROUP | WS_TABSTOP
#endif
#if defined( GITHUB_COMMIT_URL ) || defined( GITHUB_PR_HEAD_URL )
    LTEXT           "GitHub：", IDC_STATIC_URL_GITHUB_CAPTION, 16, 224, 68, 10, NOT WS_GROUP
#endif
#if defined( GITHUB_COMMIT_URL )
    LTEXT           GIT_SHORT_COMMIT_HASH, IDC_STATIC_URL_GITHUB_COMMIT, 88, 224, 108, 10, SS_NOTIFY | NOT WS_GROUP | WS_TABSTOP
#endif
#if defined( GITHUB_PR_HEAD_URL )
    LTEXT           GITHUB_PR_NUMBER_LABEL, IDC_STATIC_URL_GITHUB_PR, 204, 224, 116, 10, SS_NOTIFY | NOT WS_GROUP | WS_TABSTOP
#endif
    LTEXT           "原作者：Take-san（竹熊猫）", IDC_STATIC_ABOUT_AUTHOR, 16, 241, 304, 10, NOT WS_GROUP
    LTEXT           S_COPYRIGHT_FORK, IDC_STATIC_ABOUT_FORK_COPYRIGHT, 16, 253, 304, 10, NOT WS_GROUP | SS_NOPREFIX
    LTEXT           S_COPYRIGHT, IDC_STATIC_ABOUT_COPYRIGHT, 16, 265, 304, 10, NOT WS_GROUP | SS_NOPREFIX
    LTEXT           S_COPYRIGHT_TRANSLATION, IDC_STATIC_ABOUT_TRANSLATION, 16, 277, 304, 10, NOT WS_GROUP | SS_NOPREFIX
    PUSHBUTTON      "复制到剪贴板(&C)", IDC_BUTTON_COPY, 151, 292, 86, 16
    DEFPUSHBUTTON   "确定(&O)", IDOK, 245, 292, 75, 16
END

/////////////////////////////////////////////////////////////////////////////
//
// 设计信息
//

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO
BEGIN
    IDD_ABOUT, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 329
        TOPMARGIN, 7
        BOTTOMMARGIN, 305
    END
END
#endif    // APSTUDIO_INVOKED


/////////////////////////////////////////////////////////////////////////////
//
// 版本信息
//
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    FILE_VERSION
 PRODUCTVERSION PRODUCT_VERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x01L
#else
 FILEFLAGS 0x00L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "Comments", "这是免费软件\0"
            VALUE "CompanyName", "Sakura Editor NEXT project\0"
            VALUE "FileDescription", "Sakura Editor NEXT 简体中文语言资源\0"
            VALUE "FileVersion", VERSION_STR
            VALUE "InternalName", "sakura\0"
            VALUE "LegalCopyright", S_COPYRIGHT_FORK "; " S_COPYRIGHT "; " S_COPYRIGHT_TRANSLATION "\0"
            VALUE "LegalTrademarks", " \0"
            VALUE "OriginalFilename", "sakura.exe\0"
            VALUE "ProductName", _GSTR_APPNAME "\0"
            VALUE "ProductVersion", VERSION_STR VERSION_HASH // e.g. "2.4.1.0 (4a0de579)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// 图标
//

//最低ID值的图标放在首位，以确保应用程序图标
//在所有系统上保持一致。
#ifdef _DEBUG
IDI_ICON_STD            ICON         "../src/main/resources/images/icon_debug.ico"
#else
IDI_ICON_STD            ICON         "../src/main/resources/images/icon_std.ico"
#endif

