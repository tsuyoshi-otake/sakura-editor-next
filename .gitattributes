*.kwd text
*.khp text
*.hkn text
*.bat text eol=crlf
Makefile text eol=lf
sakura_rc.h text eol=crlf
*.rc text working-tree-encoding=utf-16le-bom eol=crlf
*.rc2 text working-tree-encoding=utf-16le-bom eol=crlf
*.ps1 text working-tree-encoding=utf-16le-bom eol=crlf
tools/startup-benchmark-sample.md text eol=lf
*.config text eol=crlf
*.csproj text eol=crlf
*.filters text eol=crlf
*.manifest text eol=crlf
*.natvis text eol=crlf
*.props text eol=crlf
*.settings text eol=crlf
*.sln text eol=crlf
*.targets text eol=crlf
*.vcxproj text eol=crlf
*.vsconfig text eol=crlf
*.yml text eol=crlf
.github/workflows/*.yml text eol=lf

# フォントは変換せずそのまま扱う
*.ttf binary
*.otf binary
*.woff binary
tools/innounp/*.exe binary

# Owned snapshots keep upstream bytes. Sakura *.rc UTF-16 / eol rules must not rewrite them.
third_party/owned/** -text -eol !working-tree-encoding
third_party/owned/**/*.rc -text -eol !working-tree-encoding
third_party/owned/**/*.rc2 -text -eol !working-tree-encoding
third_party/owned/**/*.ps1 -text -eol !working-tree-encoding
third_party/owned/**/*.yml -text -eol
third_party/owned/**/Makefile -text -eol
