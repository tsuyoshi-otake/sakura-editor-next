<Project>
  <PropertyGroup>
    <!-- vcpkg の場所 -->
    <VcpkgRoot Condition="'$(VcpkgRoot)' == '' and '$(VCPKG_ROOT)' != '' and Exists('$(VCPKG_ROOT)\scripts\buildsystems\msbuild\vcpkg.props')">$(VCPKG_ROOT)\</VcpkgRoot>
    <VcpkgRoot Condition="'$(VcpkgRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\vcpkg\scripts\buildsystems\msbuild\vcpkg.props')">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..\vcpkg\'))</VcpkgRoot>
    <VcpkgRoot Condition="'$(VcpkgRoot)' == '' and Exists('$(MSBuildThisFileDirectory)tools\vcpkg\scripts\buildsystems\msbuild\vcpkg.props')">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'tools\vcpkg\'))</VcpkgRoot>

    <!-- トリプレット -->
    <VcpkgTriplet Condition="'$(Platform)'=='x64'">x64-windows-static</VcpkgTriplet>

    <!--
      Package restoration is owned by sakura-build.  Native project evaluation
      consumes only the active, content-addressed package root and never scans
      this checkout for vcpkg.json or starts an install as a ClCompile side
      effect.  The active projection is written atomically after restore.
    -->
    <SakuraPackageActiveRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '.\build\pkg\v\a\'))</SakuraPackageActiveRoot>
    <SakuraPackageActiveProps>$(SakuraPackageActiveRoot)$(VcpkgTriplet).props</SakuraPackageActiveProps>
    <SakuraVcpkgToolchainFile>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '.\src\main\cmake\sakura-vcpkg-toolchain.cmake'))</SakuraVcpkgToolchainFile>
    <VcpkgEnableManifest>false</VcpkgEnableManifest>
    <VcpkgManifestInstall>false</VcpkgManifestInstall>
    <VcpkgAutoBootstrap>false</VcpkgAutoBootstrap>
    <VcpkgEnableClassic>true</VcpkgEnableClassic>
    <VcpkgManifestRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '.\build\packages\vcpkg\manifest-disabled\'))</VcpkgManifestRoot>
  </PropertyGroup>
  <Import Project="$(SakuraPackageActiveProps)" Condition="Exists('$(SakuraPackageActiveProps)')" />
  <ItemDefinitionGroup>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(VcpkgInstalledDir)$(VcpkgTriplet)\share\cmigemo;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <Import Project="$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.props" />
</Project>
