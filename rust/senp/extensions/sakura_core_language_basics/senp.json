{
  "schemaVersion": 1,
  "id": "sakura-core-language-basics",
  "displayName": "Core Language Basics",
  "version": "0.1.0",
  "publisher": "sakura.builtin",
  "description": "Built-in TextMate syntax highlighting for widely used programming, web, data, and scripting languages.",
  "engines": { "sakura": ">=0.1.0" },
  "contributes": {
    "languages": [
      { "id": "c", "aliases": ["C", "c"], "extensions": [".c", ".i"] },
      { "id": "cpp", "aliases": ["C++", "cpp"], "extensions": [".cpp", ".cppm", ".cc", ".ccm", ".cxx", ".cxxm", ".c++", ".hpp", ".hh", ".hxx", ".h", ".inl", ".ipp", ".ixx", ".tpp"] },
      { "id": "cuda-cpp", "aliases": ["CUDA C++", "cuda-cpp"], "extensions": [".cu", ".cuh"] },
      { "id": "csharp", "aliases": ["C#", "csharp"], "extensions": [".cs", ".csx", ".cake"] },
      { "id": "java", "aliases": ["Java", "java"], "extensions": [".java", ".jav"] },
      { "id": "rust", "aliases": ["Rust", "rust"], "extensions": [".rs"] },
      { "id": "python", "aliases": ["Python", "python"], "extensions": [".py", ".pyw", ".pyi", ".rpy", ".gyp", ".gypi"], "filenames": ["SConstruct", "SConscript"], "firstLine": "^#!.*\\bpython[0-9.]*\\b" },
      { "id": "go", "aliases": ["Go", "go"], "extensions": [".go"] },
      { "id": "javascript", "aliases": ["JavaScript", "javascript"], "extensions": [".js", ".mjs", ".cjs", ".es6", ".pac"], "filenames": ["jakefile"] },
      { "id": "javascriptreact", "aliases": ["JavaScript JSX", "javascriptreact"], "extensions": [".jsx"] },
      { "id": "typescript", "aliases": ["TypeScript", "typescript"], "extensions": [".ts", ".cts", ".mts"] },
      { "id": "typescriptreact", "aliases": ["TypeScript JSX", "typescriptreact"], "extensions": [".tsx"] },
      { "id": "json", "aliases": ["JSON", "json"], "extensions": [".json", ".webmanifest", ".har", ".jsonld", ".geojson", ".ipynb"], "filenames": ["composer.lock", ".watchmanconfig"] },
      { "id": "jsonc", "aliases": ["JSON with Comments", "jsonc"], "extensions": [".jsonc", ".eslintrc", ".jshintrc", ".babelrc"], "filenames": ["tsconfig.json", "jsconfig.json", "babel.config.json", "typedoc.json"] },
      { "id": "jsonl", "aliases": ["JSON Lines", "jsonl"], "extensions": [".jsonl", ".ndjson"] },
      { "id": "yaml", "aliases": ["YAML", "yaml"], "extensions": [".yaml", ".yml", ".eyaml", ".eyml", ".cff"] },
      { "id": "xml", "aliases": ["XML", "xml"], "extensions": [".xml", ".xsd", ".svg", ".xaml", ".csproj", ".fsproj", ".vbproj", ".vcxproj", ".props", ".targets", ".wsdl", ".rss", ".rdf"] },
      { "id": "xsl", "aliases": ["XSL", "xsl"], "extensions": [".xsl", ".xslt"] },
      { "id": "html", "aliases": ["HTML", "html"], "extensions": [".html", ".htm", ".shtml", ".xhtml", ".jsp", ".asp", ".aspx", ".ejs", ".rhtml"] },
      { "id": "css", "aliases": ["CSS", "css"], "extensions": [".css"] },
      { "id": "less", "aliases": ["Less", "less"], "extensions": [".less"] },
      { "id": "scss", "aliases": ["SCSS", "scss"], "extensions": [".scss"] },
      { "id": "markdown", "aliases": ["Markdown", "markdown"], "extensions": [".md", ".markdown", ".mdown", ".mkd", ".mdx"] },
      { "id": "php", "aliases": ["PHP", "php"], "extensions": [".php", ".php4", ".php5", ".phtml", ".ctp"] },
      { "id": "ruby", "aliases": ["Ruby", "ruby"], "extensions": [".rb", ".rake", ".gemspec", ".erb", ".rbi"], "filenames": ["Rakefile", "Gemfile", "Vagrantfile", "Fastfile"] },
      { "id": "swift", "aliases": ["Swift", "swift"], "extensions": [".swift"] },
      { "id": "lua", "aliases": ["Lua", "lua"], "extensions": [".lua"] },
      { "id": "r", "aliases": ["R", "r"], "extensions": [".R", ".Rhistory", ".Rprofile", ".rt"] },
      { "id": "dart", "aliases": ["Dart", "dart"], "extensions": [".dart"] },
      { "id": "objective-c", "aliases": ["Objective-C", "objective-c"], "extensions": [".m"] },
      { "id": "objective-cpp", "aliases": ["Objective-C++", "objective-cpp"], "extensions": [".mm"] },
      { "id": "fsharp", "aliases": ["F#", "fsharp"], "extensions": [".fs", ".fsi", ".fsx", ".fsscript"] },
      { "id": "vb", "aliases": ["Visual Basic", "vb"], "extensions": [".vb", ".vbs", ".bas", ".vba"] },
      { "id": "groovy", "aliases": ["Groovy", "groovy", "Gradle", "Jenkinsfile"], "extensions": [".groovy", ".gvy", ".gradle", ".jenkinsfile", ".nf"], "filenames": ["Jenkinsfile"], "filenamePatterns": ["Jenkinsfile*"] },
      { "id": "clojure", "aliases": ["Clojure", "clojure", "EDN"], "extensions": [".clj", ".cljs", ".cljc", ".edn"] },
      { "id": "coffeescript", "aliases": ["CoffeeScript", "coffeescript"], "extensions": [".coffee", ".cson", ".iced"] },
      { "id": "julia", "aliases": ["Julia", "julia"], "extensions": [".jl"] },
      { "id": "hlsl", "aliases": ["HLSL", "hlsl"], "extensions": [".hlsl", ".hlsli", ".fx", ".fxh", ".compute"] }
    ],
    "grammars": [
      { "language": "c", "scopeName": "source.c", "path": "assets/syntaxes/cpp/c.tmLanguage.json" },
      { "language": "cpp", "scopeName": "source.cpp", "path": "assets/syntaxes/cpp/cpp.tmLanguage.json" },
      { "scopeName": "source.cpp.embedded.macro", "path": "assets/syntaxes/cpp/cpp.embedded.macro.tmLanguage.json" },
      { "scopeName": "source.c.platform", "path": "assets/syntaxes/cpp/platform.tmLanguage.json" },
      { "language": "cuda-cpp", "scopeName": "source.cuda-cpp", "path": "assets/syntaxes/cpp/cuda-cpp.tmLanguage.json" },
      { "language": "csharp", "scopeName": "source.cs", "path": "assets/syntaxes/csharp/csharp.tmLanguage.json" },
      { "language": "java", "scopeName": "source.java", "path": "assets/syntaxes/java/java.tmLanguage.json" },
      { "language": "rust", "scopeName": "source.rust", "path": "assets/syntaxes/rust/rust.tmLanguage.json" },
      { "language": "python", "scopeName": "source.python", "path": "assets/syntaxes/python/MagicPython.tmLanguage.json" },
      { "scopeName": "source.regexp.python", "path": "assets/syntaxes/python/MagicRegExp.tmLanguage.json" },
      { "language": "go", "scopeName": "source.go", "path": "assets/syntaxes/go/go.tmLanguage.json" },
      { "language": "javascript", "scopeName": "source.js", "path": "assets/syntaxes/javascript/JavaScript.tmLanguage.json" },
      { "language": "javascriptreact", "scopeName": "source.js.jsx", "path": "assets/syntaxes/javascript/JavaScriptReact.tmLanguage.json" },
      { "scopeName": "source.js.regexp", "path": "assets/syntaxes/javascript/javascript-regexp.tmLanguage" },
      { "language": "typescript", "scopeName": "source.ts", "path": "assets/syntaxes/typescript/TypeScript.tmLanguage.json" },
      { "language": "typescriptreact", "scopeName": "source.tsx", "path": "assets/syntaxes/typescript/TypeScriptReact.tmLanguage.json" },
      { "scopeName": "documentation.injection.ts", "path": "assets/syntaxes/typescript/jsdoc.ts.injection.tmLanguage.json", "injectTo": ["source.ts", "source.tsx"] },
      { "scopeName": "documentation.injection.js.jsx", "path": "assets/syntaxes/typescript/jsdoc.js.injection.tmLanguage.json", "injectTo": ["source.js", "source.js.jsx"] },
      { "language": "json", "scopeName": "source.json", "path": "assets/syntaxes/json/JSON.tmLanguage.json" },
      { "language": "jsonc", "scopeName": "source.json.comments", "path": "assets/syntaxes/json/JSONC.tmLanguage.json" },
      { "language": "jsonl", "scopeName": "source.json.lines", "path": "assets/syntaxes/json/JSONL.tmLanguage.json" },
      { "language": "yaml", "scopeName": "source.yaml", "path": "assets/syntaxes/yaml/yaml.tmLanguage.json" },
      { "scopeName": "source.yaml.1.3", "path": "assets/syntaxes/yaml/yaml-1.3.tmLanguage.json" },
      { "scopeName": "source.yaml.1.2", "path": "assets/syntaxes/yaml/yaml-1.2.tmLanguage.json" },
      { "scopeName": "source.yaml.1.1", "path": "assets/syntaxes/yaml/yaml-1.1.tmLanguage.json" },
      { "scopeName": "source.yaml.1.0", "path": "assets/syntaxes/yaml/yaml-1.0.tmLanguage.json" },
      { "scopeName": "source.yaml.embedded", "path": "assets/syntaxes/yaml/yaml-embedded.tmLanguage.json" },
      { "language": "xml", "scopeName": "text.xml", "path": "assets/syntaxes/xml/xml.tmLanguage.json" },
      { "language": "xsl", "scopeName": "text.xml.xsl", "path": "assets/syntaxes/xml/xsl.tmLanguage.json" },
      { "language": "html", "scopeName": "text.html.derivative", "path": "assets/syntaxes/html/html-derivative.tmLanguage.json" },
      { "scopeName": "text.html.basic", "path": "assets/syntaxes/html/html.tmLanguage.json" },
      { "language": "css", "scopeName": "source.css", "path": "assets/syntaxes/css/css.tmLanguage.json" },
      { "language": "less", "scopeName": "source.css.less", "path": "assets/syntaxes/less/less.tmLanguage.json" },
      { "language": "scss", "scopeName": "source.css.scss", "path": "assets/syntaxes/scss/scss.tmLanguage.json" },
      { "scopeName": "source.sassdoc", "path": "assets/syntaxes/scss/sassdoc.tmLanguage.json" },
      { "language": "markdown", "scopeName": "text.html.markdown", "path": "assets/syntaxes/markdown/markdown.tmLanguage.json" },
      { "language": "php", "scopeName": "source.php", "path": "assets/syntaxes/php/php.tmLanguage.json" },
      { "scopeName": "text.html.php", "path": "assets/syntaxes/php/html.tmLanguage.json" },
      { "language": "ruby", "scopeName": "source.ruby", "path": "assets/syntaxes/ruby/ruby.tmLanguage.json" },
      { "language": "swift", "scopeName": "source.swift", "path": "assets/syntaxes/swift/swift.tmLanguage.json" },
      { "language": "lua", "scopeName": "source.lua", "path": "assets/syntaxes/lua/lua.tmLanguage.json" },
      { "language": "r", "scopeName": "source.r", "path": "assets/syntaxes/r/r.tmLanguage.json" },
      { "language": "dart", "scopeName": "source.dart", "path": "assets/syntaxes/dart/dart.tmLanguage.json" },
      { "language": "objective-c", "scopeName": "source.objc", "path": "assets/syntaxes/objective-c/objective-c.tmLanguage.json" },
      { "language": "objective-cpp", "scopeName": "source.objcpp", "path": "assets/syntaxes/objective-c/objective-cpp.tmLanguage.json" },
      { "language": "fsharp", "scopeName": "source.fsharp", "path": "assets/syntaxes/fsharp/fsharp.tmLanguage.json" },
      { "language": "vb", "scopeName": "source.asp.vb.net", "path": "assets/syntaxes/vb/asp-vb-net.tmLanguage.json" },
      { "language": "groovy", "scopeName": "source.groovy", "path": "assets/syntaxes/groovy/groovy.tmLanguage.json" },
      { "language": "clojure", "scopeName": "source.clojure", "path": "assets/syntaxes/clojure/clojure.tmLanguage.json" },
      { "language": "coffeescript", "scopeName": "source.coffee", "path": "assets/syntaxes/coffeescript/coffeescript.tmLanguage.json" },
      { "language": "julia", "scopeName": "source.julia", "path": "assets/syntaxes/julia/julia.tmLanguage.json" },
      { "language": "hlsl", "scopeName": "source.hlsl", "path": "assets/syntaxes/hlsl/hlsl.tmLanguage.json" }
    ]
  }
}
