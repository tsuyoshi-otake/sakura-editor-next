{
  "schemaVersion": 2,
  "id": "sakura-github-pull-requests",
  "displayName": "GitHub Issues and Pull Requests",
  "version": "0.1.0",
  "publisher": "sakura.builtin",
  "description": "Browse repository issues and pull requests.",
  "engines": { "sakura": ">=0.1.0" },
  "runtime": {
    "abi": "sakura:senp/extension@3.0.0",
    "module": "module/extension.wasm"
  },
  "activationEvents": ["onView:pr:github", "onView:issues:github"],
  "capabilities": [
    "workbench.views.tree",
    "workbench.documents.readonly",
    "workbench.commands",
    "workspace.repositories.read",
    "tools.github.repository.read"
  ],
  "contributes": {
    "commands": [
      { "command": "github.openIssue", "title": "Open Issue" },
      { "command": "github.openIssueComment", "title": "Open Comment" },
      { "command": "github.openPullRequest", "title": "Open Pull Request" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "github-pull-requests", "title": "GitHub", "icon": "$(github)", "order": 6 }
      ]
    },
    "views": {
      "github-pull-requests": [
        { "id": "pr:github", "name": "Pull Requests", "provider": "senp.tree", "order": 10 },
        { "id": "issues:github", "name": "Issues", "provider": "senp.tree", "order": 20 }
      ]
    }
  }
}
