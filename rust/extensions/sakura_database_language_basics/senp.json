{
  "schemaVersion": 1,
  "id": "sakura-database-language-basics",
  "displayName": "Database Language Basics",
  "version": "0.1.0",
  "publisher": "sakura.builtin",
  "description": "SQL, Oracle PL/SQL and SQL*Plus, and database configuration syntax highlighting.",
  "engines": { "sakura": ">=0.1.0" },
  "contributes": {
    "languages": [
      { "id": "sql", "aliases": ["SQL", "T-SQL"], "extensions": [".sql", ".dsql", ".tsql", ".psql", ".pgsql", ".mysql"] },
      { "id": "plsql", "aliases": ["Oracle PL/SQL", "PL/SQL", "SQL*Plus"], "extensions": [".pls", ".plsql", ".pks", ".pkb", ".trg", ".fnc", ".prc"] },
      {
        "id": "database-config",
        "aliases": ["Database Configuration", "DB Config", "Oracle Net Configuration"],
        "extensions": [".ora"],
        "filenames": ["tnsnames.ora", "listener.ora", "sqlnet.ora", "postgresql.conf", "pg_hba.conf", "pg_ident.conf", "my.cnf", "odbc.ini", "odbcinst.ini", "flyway.conf"],
        "filenamePatterns": ["*.cnf", "*.dsn", "*.odbc.ini", "flyway*.conf"]
      },
      {
        "id": "liquibase",
        "aliases": ["Liquibase Changelog", "Liquibase"],
        "filenames": ["liquibase.properties", "db.changelog-master.yaml", "db.changelog-master.yml", "db.changelog-master.xml"],
        "filenamePatterns": ["*liquibase*.properties", "*changelog*.yaml", "*changelog*.yml", "*changelog*.xml"]
      }
    ],
    "grammars": [
      { "language": "sql", "scopeName": "source.sql", "path": "assets/syntaxes/sql.tmLanguage.json" },
      { "language": "plsql", "scopeName": "source.plsql", "path": "assets/syntaxes/plsql.tmLanguage.json" },
      { "language": "database-config", "scopeName": "source.database-config", "path": "assets/syntaxes/database-config.tmLanguage.json" },
      { "language": "liquibase", "scopeName": "source.liquibase", "path": "assets/syntaxes/liquibase.tmLanguage.json" }
    ]
  }
}
