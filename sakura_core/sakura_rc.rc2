// このファイルにはリソースエディタで編集できない要素を配置します.
// このファイルのエンコーディング/改行コードは UTF-16LE(BOM)/CRLF です.

#define _GSTR_APPNAME "Sakura Editor NEXT"

#define	S_COPYRIGHT_FORK	"Copyright (C) 2026 Tsuyoshi Otake"
#define	S_COPYRIGHT	"Copyright (C) 1998-2022  by Norio Nakatani & Collaborators"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUT DIALOG 0, 0, 336, 312
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "バージョン情報"
FONT 9, "Yu Gothic UI"
BEGIN
    ICON            IDI_ICON_STD, IDC_STATIC_MYICON, 16, 15, 28, 28, SS_NOTIFY
    LTEXT           "Sakura Editor NEXT", IDC_STATIC_ABOUT_NAME, 56, 14, 264, 18, NOT WS_GROUP
    LTEXT           "", IDC_STATIC_ABOUT_VERSION, 56, 36, 264, 13, NOT WS_GROUP
    LTEXT           "", IDC_EDIT_ABOUT, 16, 62, 304, 32, NOT WS_GROUP
    LTEXT           "ビルド情報", IDC_STATIC_ABOUT_BUILD_HEADING, 16, 102, 304, 11, NOT WS_GROUP
    EDITTEXT        IDC_EDIT_VER, 16, 116, 304, 42, ES_MULTILINE | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT           "リンク", IDC_STATIC_ABOUT_LINKS_HEADING, 16, 166, 304, 11, NOT WS_GROUP
    LTEXT           "プロジェクト:", IDC_STATIC_URL_CAPTION, 16, 182, 68, 10, NOT WS_GROUP
    LTEXT           "https://github.com/tsuyoshi-otake/sakura-editor-next", IDC_STATIC_URL_UR, 88, 182, 232, 10, SS_NOTIFY | NOT WS_GROUP | WS_TABSTOP
#ifdef GIT_REMOTE_ORIGIN_URL
    LTEXT           "ソース:", IDC_STATIC_GIT_CAPTION, 16, 196, 68, 10, NOT WS_GROUP
    LTEXT           GIT_REMOTE_ORIGIN_URL, IDC_STATIC_URL_GIT, 88, 196, 232, 10, SS_NOTIFY | NOT WS_GROUP | WS_TABSTOP
#endif
#ifdef CI_BUILD_NUMBER_LABEL
    LTEXT           "ビルド:", IDC_STATIC_URL_CI_BUILD_CAPTION, 16, 210, 68, 10, NOT WS_GROUP
    LTEXT           CI_BUILD_NUMBER_LABEL, IDC_STATIC_URL_CI_BUILD, 88, 210, 232, 10, SS_NOTIFY | NOT WS_GROUP | WS_TABSTOP
#endif
#if defined( GITHUB_COMMIT_URL ) || defined( GITHUB_PR_HEAD_URL )
    LTEXT           "GitHub:", IDC_STATIC_URL_GITHUB_CAPTION, 16, 224, 68, 10, NOT WS_GROUP
#endif
#if defined( GITHUB_COMMIT_URL )
    LTEXT           GIT_SHORT_COMMIT_HASH, IDC_STATIC_URL_GITHUB_COMMIT, 88, 224, 108, 10, SS_NOTIFY | NOT WS_GROUP | WS_TABSTOP
#endif
#if defined( GITHUB_PR_HEAD_URL )
    LTEXT           GITHUB_PR_NUMBER_LABEL, IDC_STATIC_URL_GITHUB_PR, 204, 224, 116, 10, SS_NOTIFY | NOT WS_GROUP | WS_TABSTOP
#endif
    LTEXT           "原作者: たけ (竹パンダ)", IDC_STATIC_ABOUT_AUTHOR, 16, 241, 304, 10, NOT WS_GROUP
    LTEXT           S_COPYRIGHT_FORK, IDC_STATIC_ABOUT_FORK_COPYRIGHT, 16, 253, 304, 10, NOT WS_GROUP | SS_NOPREFIX
    LTEXT           S_COPYRIGHT, IDC_STATIC_ABOUT_COPYRIGHT, 16, 265, 304, 10, NOT WS_GROUP | SS_NOPREFIX
    LTEXT           "", IDC_STATIC_ABOUT_TRANSLATION, 16, 277, 304, 10, NOT WS_GROUP
    PUSHBUTTON      "情報をコピー(&C)", IDC_BUTTON_COPY, 151, 292, 86, 16
    DEFPUSHBUTTON   "OK", IDOK, 245, 292, 75, 16
END
/////////////////////////////////////////////////////////////////////////////
//
// DESIGNINFO
//

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO DISCARDABLE 
BEGIN
    IDD_ABOUT, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 329
        TOPMARGIN, 7
        BOTTOMMARGIN, 305
    END
END
#endif    // APSTUDIO_INVOKED


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    FILE_VERSION
 PRODUCTVERSION PRODUCT_VERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x01L
#else
 FILEFLAGS 0x00L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "Comments", "このソフトはフリーソフトです。\0"
            VALUE "CompanyName", "Sakura Editor NEXT project\0"
            VALUE "FileDescription", "Sakura Editor NEXT\0"
            VALUE "FileVersion", VERSION_STR
            VALUE "InternalName", "sakura\0"
            VALUE "LegalCopyright", S_COPYRIGHT_FORK "; " S_COPYRIGHT
            VALUE "LegalTrademarks", " \0"
            VALUE "OriginalFilename", "sakura.exe\0"
            VALUE "ProductName", _GSTR_APPNAME "\0"
            VALUE "ProductVersion", VERSION_STR VERSION_HASH    // e.g. "2.4.1.0 (4a0de579)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
#ifdef _DEBUG
IDI_ICON_STD            ICON         "../src/main/resources/images/icon_debug.ico"
#else
IDI_ICON_STD            ICON         "../src/main/resources/images/icon_std.ico"
#endif

/////////////////////////////////////////////////////////////////////////////
//
// Codicon font
//

// 実 VS Code と同じく、組み込みの $(name) アイコンは codicon.ttf の 1 グリフとして描く。
// 外部ファイルにせず実行ファイルへ埋め込むのは、配布物から 1 ファイル欠けただけで全ての
// 組み込みアイコンが黙って別物になる、という壊れ方を避けるため。読み出しは
// workbench/icons/CCodiconFont.cpp。名前付きリソースなので数値 ID 空間と衝突しない。
CODICONFONT             RCDATA       "workbench/icons/codicon.ttf"

/////////////////////////////////////////////////////////////////////////////
//
// Seti icon font
//

// VS Code の既定 File Icon Theme `vs-seti` のグリフを描くフォント。実 VS Code は
// theme-seti 拡張の seti.woff を使うが、GDI は WOFF を読めないのでコンテナを外した
// seti.ttf を同梱する（tools/generate-seti-icon-theme.py が変換と検証を行う）。
// 読み出しは workbench/icons/CSetiFont.cpp。
SETIFONT                RCDATA       "workbench/icons/seti.ttf"

/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE
BEGIN
	// CBregexp.cpp
	STR_BREGONIG_LOAD				"bregonig.dll のロードに失敗しました。\r\n正規表現を利用するには Unicode 版の bregonig.dll が必要です。\r\n入手方法はヘルプを参照してください。"
	STR_BREGONIG_INIT				"bregonig.dll の利用に失敗しました。\r\n正規表現を利用するには Unicode 版の bregonig.dll が必要です。\r\n入手方法はヘルプを参照してください。"
	STR_GSTR_APPNAME				_GSTR_APPNAME

	// Select Language
	STR_SELLANG_NAME				"Japanese"						// language name [Primary language (Sublanguage)]
	STR_SELLANG_LANGID				"0x0411"						// language id (hexadecimal string)
		// See following link:
		//  http://msdn.microsoft.com/en-us/library/dd318693.aspx
END
