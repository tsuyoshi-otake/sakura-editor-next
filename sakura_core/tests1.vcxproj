  <Target Name="CollectSakuraObjectsForTests1" DependsOnTargets="ResolveProjectReferences" BeforeTargets="Link">
    <!--
      The production project records the exact compiler/resource outputs after its
      project dependency has completed.  Reading that manifest avoids linking stale
      files left in the shared production intermediate directory after a rename.
    -->
    <Error Condition="!Exists('$(SakuraLinkInputsForTests1File)')"
           Code="SAKURA0002"
           Text="The Sakura production link-input manifest was not generated before tests1 linked." />
    <ReadLinesFromFile File="$(SakuraLinkInputsForTests1File)">
      <Output TaskParameter="Lines" ItemName="_SakuraLinkInputForTests1" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_MissingSakuraLinkInputForTests1 Include="@(_SakuraLinkInputForTests1)"
                                        Condition="!Exists('%(_SakuraLinkInputForTests1.Identity)')" />
      <Link Include="@(_SakuraLinkInputForTests1)" />
    </ItemGroup>
    <Error Condition="'@(_SakuraLinkInputForTests1)' == ''"
           Code="SAKURA0002"
           Text="The Sakura production link-input manifest was empty." />
    <Error Condition="'@(_MissingSakuraLinkInputForTests1)' != ''"
           Code="SAKURA0004"
           Text="The Sakura production link-input manifest referenced missing files: @(_MissingSakuraLinkInputForTests1, ', ')." />
  </Target>
