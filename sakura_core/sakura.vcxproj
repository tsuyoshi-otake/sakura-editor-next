  <Import Project="..\src\main\msbuild\cmake.targets" />
  <Target Name="WriteSakuraLinkInputsForTests1" DependsOnTargets="ClCompile;ResourceCompile" BeforeTargets="Link">
    <!--
      tests1 links the production object files directly.  Derive the standard VC++
      output names from the declared source/resource items so removed or renamed
      stale files in $(IntDir) can never become accidental test linker inputs.
    -->
    <ItemGroup>
      <_SakuraLinkInputForTests1 Include="@(ClCompile->'$(IntDir)%(Filename).obj');@(ResourceCompile->'$(IntDir)%(Filename).res')" />
    </ItemGroup>
    <Error Condition="'@(_SakuraLinkInputForTests1)' == ''"
           Code="SAKURA0003"
           Text="No production object or resource outputs were available for the tests1 link-input manifest." />
    <WriteLinesToFile File="$(SakuraLinkInputsForTests1File)"
                      Lines="@(_SakuraLinkInputForTests1)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="Unicode" />
  </Target>
  <Target Name="RunCompileTests" Condition="!Exists('..\build\$(Platform)\CMakeTools\compiletests\CMakeCache.txt')" DependsOnTargets="GenerateVersionHeader" BeforeTargets="ClCompile">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' -A $(Platform) -B '$(CMakeToolsPath)/compiletests' -S '$([MSBuild]::NormalizePath('$(CMakeToolsSourceDir)', '.\src\test\resources\compiletests'))' -DCMAKE_CONFIGURATION_TYPES='Debug;Release' -DCMAKE_SYSTEM_VERSION='10.0.22621.0' &amp;&amp; &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target run_compiletests -- /nologo /nr:false /p:TrackFileAccess=false&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" />
  </Target>
  <Target Name="GenerateBregonig" Condition="!Exists('$(SakuraSharedOutDir)bregonig.dll')" BeforeTargets="ClCompile">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_bregonig -- /nologo /nr:false /p:TrackFileAccess=false&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" />
  </Target>
  <Target Name="GenerateMigemo" Condition="!Exists('$(SakuraSharedOutDir)migemo.dll')" BeforeTargets="ClCompile">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_cmigemo -- /nologo /nr:false /p:TrackFileAccess=false&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" />
  </Target>
  <Target Name="GenerateCTags" Condition="!Exists('$(SakuraSharedOutDir)ctags.exe')" AfterTargets="Link">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_ctags -- /nologo /nr:false /p:TrackFileAccess=false&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" WorkingDirectory="..\" />
  </Target>
  <Target Name="GenerateDiff" Condition="!Exists('$(SakuraSharedOutDir)diff.exe')" AfterTargets="Link">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_diffutils -- /nologo /nr:false /p:TrackFileAccess=false&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" WorkingDirectory="..\" />
  </Target>
  <Target Name="RemoveSakuraExe" Condition="Exists('$(TargetPath)')" DependsOnTargets="WriteSakuraLinkInputsForTests1;GenerateSakuraExeManifest" BeforeTargets="Link" Inputs="@(_SakuraLinkInputForTests1);$(CMakeToolsBuildDir)sakura.exe.manifest;$(MSBuildAllProjects)" Outputs="$(TargetPath)">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File &quot;$(MSBuildProjectDirectory)\..\tools\Remove-FileWithRetry.ps1&quot; -LiteralPath &quot;$(TargetPath)&quot;" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" />
  </Target>
  <Target Name="GenerateLang_en_US" Inputs="..\src\main\cmake\version.h.in;@(FuncCodeRes);@(RcInclude);..\sakura_lang\sakura_rc_en-US.rc;..\sakura_lang\sakura_rc_en-US.rc2" Outputs="$(SakuraSharedOutDir)sakura_lang_en_US.dll" AfterTargets="GenerateFuncCodeDefine;Link">
    <Exec Command="%22$(CMakeExe)%22 --build $(CMakeToolsPath) --config $(Configuration) --target sakura_lang_en_US -- /nologo /nr:false /p:TrackFileAccess=false" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" />
