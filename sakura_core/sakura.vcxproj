  <Import Project="..\src\main\modules\generated\msbuild\consumers\sakura_app.props"
          Condition="Exists('..\src\main\modules\generated\msbuild\consumers\sakura_app.props')" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
  <Import Project="..\src\main\msbuild\cmake.targets" />
  <!--
    tests1 consumes the legacy implementation through this archive rather than
    aggregating sakura's raw object files.  The archive is a stable test-link
    artifact with the same source closure as the product; selected component
    leaves remain normal ProjectReference libraries in tests1.props.
  -->
  <ItemGroup>
    <_SakuraTestSupportObject Include="@(ClCompile->'$(IntDir)%(Filename).obj')" />
  </ItemGroup>
  <Target Name="BuildSakuraTestSupportLibrary"
          DependsOnTargets="ClCompile"
          Inputs="@(_SakuraTestSupportObject);$(MSBuildProjectFullPath)"
          Outputs="$(SakuraTestSupportLibrary)">
    <Error Condition="'@(_SakuraTestSupportObject)' == ''"
           Code="SAKURA0003"
           Text="No production object outputs were available for the Sakura test-support archive." />
    <Error Condition="!Exists('$(SakuraTestSupportLibExe)')"
           Code="SAKURA0006"
           Text="The selected Visual C++ library tool was not found: $(SakuraTestSupportLibExe)" />
    <WriteLinesToFile File="$(SakuraTestSupportResponseFile)"
                      Lines="@(_SakuraTestSupportObject->'&quot;%(Identity)&quot;')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="Unicode" />
    <Exec Command="&quot;$(SakuraTestSupportLibExe)&quot; /NOLOGO /OUT:&quot;$(SakuraTestSupportLibrary)&quot; @&quot;$(SakuraTestSupportResponseFile)&quot;" />
  </Target>
  <Target Name="RunCompileTests" Condition="!Exists('..\build\$(Platform)\CMakeTools\compiletests\CMakeCache.txt')" DependsOnTargets="GenerateVersionHeader" BeforeTargets="ClCompile">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' -A $(Platform) -B '$(CMakeToolsPath)/compiletests' -S '$([MSBuild]::NormalizePath('$(CMakeToolsSourceDir)', '.\src\test\resources\compiletests'))' -DCMAKE_CONFIGURATION_TYPES='Debug;Release' -DCMAKE_SYSTEM_VERSION='10.0.22621.0' &amp;&amp; &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target run_compiletests -- /nologo /nr:false /p:TrackFileAccess=false&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" />
  </Target>
  <Target Name="GenerateBregonig" Condition="!Exists('$(SakuraSharedOutDir)bregonig.dll')" BeforeTargets="ClCompile">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_bregonig -- /nologo /nr:false /p:TrackFileAccess=false&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" />
  </Target>
  <Target Name="GenerateMigemo" Condition="!Exists('$(SakuraSharedOutDir)migemo.dll')" BeforeTargets="ClCompile">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_cmigemo -- /nologo /nr:false /p:TrackFileAccess=false&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" />
  </Target>
  <!--
    /GL retains /Fa in every object.  cl.exe first writes a provisional listing
    while compiling that object, then Link/LTCG writes the final listing to the
    same path.  Link does not reliably replace the existing file, even with one
    code-generation thread, so remove just those provisional listings after
    ClCompile and before the product Link.  The Link output remains the shipped
    assembly-listing artifact.
  -->
  <Target Name="RemoveSakuraAssemblyListingsBeforeLink"
          Condition="('$(SAKURA_GENERATE_ASSEMBLY_LISTINGS)'=='1' Or '$(SAKURA_GENERATE_ASSEMBLY_LISTINGS)'=='true') And '$(Configuration)'=='Release'"
          BeforeTargets="Link">
    <ItemGroup>
      <_SakuraAssemblyListing Include="$(IntDir)*.asm" />
    </ItemGroup>
    <Delete Files="@(_SakuraAssemblyListing)" />
  </Target>
  <Target Name="GenerateCTags" Condition="!Exists('$(SakuraSharedOutDir)ctags.exe')" AfterTargets="Link">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_ctags -- /nologo /nr:false /p:TrackFileAccess=false&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" WorkingDirectory="..\" />
  </Target>
  <Target Name="GenerateDiff" Condition="!Exists('$(SakuraSharedOutDir)diff.exe')" AfterTargets="Link">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_diffutils -- /nologo /nr:false /p:TrackFileAccess=false&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" WorkingDirectory="..\" />
  </Target>
  <Target Name="RemoveSakuraExe" Condition="Exists('$(TargetPath)')" DependsOnTargets="GenerateSakuraExeManifest" BeforeTargets="Link" Inputs="@(ClCompile);@(ResourceCompile);$(CMakeToolsBuildDir)sakura.exe.manifest;$(MSBuildAllProjects)" Outputs="$(TargetPath)">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File &quot;$(MSBuildProjectDirectory)\..\tools\Remove-FileWithRetry.ps1&quot; -LiteralPath &quot;$(TargetPath)&quot;" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" />
  </Target>
  <Target Name="GenerateLang_en_US" Inputs="..\src\main\cmake\version.h.in;@(FuncCodeRes);@(RcInclude);..\sakura_lang\sakura_rc_en-US.rc;..\sakura_lang\sakura_rc_en-US.rc2" Outputs="$(SakuraSharedOutDir)sakura_lang_en_US.dll" AfterTargets="GenerateFuncCodeDefine;Link">
    <Exec Command="%22$(CMakeExe)%22 --build $(CMakeToolsPath) --config $(Configuration) --target sakura_lang_en_US -- /nologo /nr:false /p:TrackFileAccess=false" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" />
  </Target>
  <Target Name="GenerateLang_zh_CN" Inputs="..\src\main\cmake\version.h.in;@(FuncCodeRes);@(RcInclude);..\sakura_lang\sakura_rc_zh-CN.rc;..\sakura_lang\sakura_rc_zh-CN.rc2" Outputs="$(SakuraSharedOutDir)sakura_lang_zh_CN.dll" AfterTargets="GenerateFuncCodeDefine;Link">
    <Exec Command="%22$(CMakeExe)%22 --build $(CMakeToolsPath) --config $(Configuration) --target sakura_lang_zh_CN -- /nologo /nr:false /p:TrackFileAccess=false" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" />
  </Target>
  <Target Name="AppendCleanTargets" BeforeTargets="CoreClean">
    <!-- Add files to @Clean just before running CoreClean. -->
    <ItemGroup>
      <Clean Include="$(SakuraSharedOutDir)sakura.ini" />
      <Clean Include="$(SakuraSharedOutDir)sakura_lang_en_US.dll" />
      <Clean Include="$(SakuraSharedOutDir)sakura_lang_en_US.pdb" />
      <Clean Include="$(SakuraSharedOutDir)sakura_lang_zh_CN.dll" />
      <Clean Include="$(SakuraSharedOutDir)sakura_lang_zh_CN.pdb" />
      <Clean Include="$(SakuraSharedOutDir)bregonig.dll" />
      <Clean Include="$(SakuraSharedOutDir)migemo.dll" />
      <Clean Include="$(SakuraSharedOutDir)ctags.exe" />
    </ItemGroup>
    <ItemGroup>
      <Clean Include="$(SakuraTestSupportLibrary)" />
      <Clean Include="$(SakuraTestSupportResponseFile)" />
      <Clean Include="$(IntDir)*.asm" />
    </ItemGroup>
  </Target>
  <Target Name="ValidateX64Platform" Condition="'$(DesignTimeBuild)' != 'true' and '$(Platform)' != 'x64'">
    <Error Code="SAKURA0001" Text="Sakura Editor NEXT supports only the x64 platform. Build with /p:Platform=x64." />
  </Target>
