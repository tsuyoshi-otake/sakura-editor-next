<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="SakuraNativeFfi">
    <SAKURA_UTF16_PRODUCTION_PACKAGE Condition="'$(SAKURA_UTF16_PRODUCTION_PACKAGE)'==''">false</SAKURA_UTF16_PRODUCTION_PACKAGE>
    <SakuraUtf16ProductionPackageUpper>$(SAKURA_UTF16_PRODUCTION_PACKAGE.ToUpperInvariant())</SakuraUtf16ProductionPackageUpper>
    <SAKURA_OUTPUT_PRODUCTION_PACKAGE Condition="'$(SAKURA_OUTPUT_PRODUCTION_PACKAGE)'==''">false</SAKURA_OUTPUT_PRODUCTION_PACKAGE>
    <SakuraOutputProductionPackageUpper>$(SAKURA_OUTPUT_PRODUCTION_PACKAGE.ToUpperInvariant())</SakuraOutputProductionPackageUpper>
    <!-- UTF-16 and Output package contexts are independent contracts. -->
    <!-- G0 rollback-first default: C++ remains the production provider while
         Rust is always built and linked as the explicitly observable candidate. -->
    <SAKURA_UTF16_BACKEND Condition="'$(SAKURA_UTF16_BACKEND)'==''">cpp</SAKURA_UTF16_BACKEND>
    <SAKURA_OUTPUT_BACKEND Condition="'$(SAKURA_OUTPUT_BACKEND)'==''">cpp</SAKURA_OUTPUT_BACKEND>
    <SAKURA_UTF16_BENCHMARK_TELEMETRY Condition="'$(SAKURA_UTF16_BENCHMARK_TELEMETRY)'==''">false</SAKURA_UTF16_BENCHMARK_TELEMETRY>
    <SakuraUtf16BenchmarkTelemetryUpper>$(SAKURA_UTF16_BENCHMARK_TELEMETRY.ToUpperInvariant())</SakuraUtf16BenchmarkTelemetryUpper>
    <SakuraUtf16BackendUpper>$(SAKURA_UTF16_BACKEND.ToUpperInvariant())</SakuraUtf16BackendUpper>
    <SakuraOutputBackendUpper>$(SAKURA_OUTPUT_BACKEND.ToUpperInvariant())</SakuraOutputBackendUpper>

    <!-- Native Cargo is intentionally rooted below rust/native. SENP has a
         different workspace, lockfile, target directory, and source closure. -->
    <SakuraNativeFfiRepoRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..\..\..\'))</SakuraNativeFfiRepoRoot>
    <SakuraNativeFfiWorkspace>$([MSBuild]::NormalizePath('$(SakuraNativeFfiRepoRoot)', 'rust\native'))</SakuraNativeFfiWorkspace>
    <SakuraNativeFfiManifest>$([MSBuild]::NormalizePath('$(SakuraNativeFfiWorkspace)', 'Cargo.toml'))</SakuraNativeFfiManifest>
    <SakuraNativeFfiMemberManifest>$([MSBuild]::NormalizePath('$(SakuraNativeFfiWorkspace)', 'sakura_native_ffi\Cargo.toml'))</SakuraNativeFfiMemberManifest>
    <SakuraNativeFfiSimdManifest>$([MSBuild]::NormalizePath('$(SakuraNativeFfiWorkspace)', 'sakura_simd\Cargo.toml'))</SakuraNativeFfiSimdManifest>
    <SakuraNativeFfiUnicodeManifest>$([MSBuild]::NormalizePath('$(SakuraNativeFfiWorkspace)', 'sakura_unicode_core\Cargo.toml'))</SakuraNativeFfiUnicodeManifest>
    <SakuraNativeFfiCargo Condition="'$(SakuraNativeFfiCargo)'==''">cargo</SakuraNativeFfiCargo>
    <SakuraNativeFfiTargetDir>$([MSBuild]::NormalizePath('$(SakuraNativeFfiRepoRoot)', 'build\$(Platform)\$(Configuration)\rust\native'))</SakuraNativeFfiTargetDir>
    <SakuraNativeFfiCargoProfile Condition="'$(Configuration)'=='Debug'">dev</SakuraNativeFfiCargoProfile>
    <SakuraNativeFfiProfileDirectory Condition="'$(Configuration)'=='Debug'">debug</SakuraNativeFfiProfileDirectory>
    <SakuraNativeFfiCargoProfile Condition="'$(Configuration)'=='Release'">release</SakuraNativeFfiCargoProfile>
    <SakuraNativeFfiProfileDirectory Condition="'$(Configuration)'=='Release'">release</SakuraNativeFfiProfileDirectory>
    <SakuraNativeFfiLibrary>$([MSBuild]::NormalizePath('$(SakuraNativeFfiTargetDir)', 'x86_64-pc-windows-msvc\$(SakuraNativeFfiProfileDirectory)\sakura_native_ffi.lib'))</SakuraNativeFfiLibrary>
    <SakuraNativeFfiStamp>$([MSBuild]::NormalizePath('$(SakuraNativeFfiTargetDir)', 'x86_64-pc-windows-msvc\$(SakuraNativeFfiProfileDirectory)\sakura_native_ffi.msbuild.stamp'))</SakuraNativeFfiStamp>
    <!-- These are the stable native libraries reported by rustc's
         native-static-libs output for the x86_64-pc-windows-msvc std runtime.
         The C++ project supplies some defaults, but the Rust staticlib must
         carry the complete system-library closure explicitly. -->
    <SakuraNativeFfiSystemLibraries Condition="'$(SakuraNativeFfiSystemLibraries)'==''">kernel32.lib;ntdll.lib;userenv.lib;ws2_32.lib;dbghelp.lib</SakuraNativeFfiSystemLibraries>

    <!-- Keep the established property/target names as compatibility shims for
         existing project imports and explicit diagnostic invocations. They
         resolve to the one native FFI archive and never name a second library. -->
    <SakuraRustCoreRepoRoot Condition="'$(SakuraRustCoreRepoRoot)'==''">$(SakuraNativeFfiRepoRoot)</SakuraRustCoreRepoRoot>
    <SakuraRustCoreWorkspace Condition="'$(SakuraRustCoreWorkspace)'==''">$(SakuraNativeFfiWorkspace)</SakuraRustCoreWorkspace>
    <SakuraRustCoreManifest Condition="'$(SakuraRustCoreManifest)'==''">$(SakuraNativeFfiManifest)</SakuraRustCoreManifest>
    <SakuraRustCoreMemberManifest Condition="'$(SakuraRustCoreMemberManifest)'==''">$(SakuraNativeFfiMemberManifest)</SakuraRustCoreMemberManifest>
    <SakuraRustCoreCargo Condition="'$(SakuraRustCoreCargo)'==''">$(SakuraNativeFfiCargo)</SakuraRustCoreCargo>
    <SakuraRustCoreTargetDir Condition="'$(SakuraRustCoreTargetDir)'==''">$(SakuraNativeFfiTargetDir)</SakuraRustCoreTargetDir>
    <SakuraRustCoreCargoProfile Condition="'$(SakuraRustCoreCargoProfile)'==''">$(SakuraNativeFfiCargoProfile)</SakuraRustCoreCargoProfile>
    <SakuraRustCoreProfileDirectory Condition="'$(SakuraRustCoreProfileDirectory)'==''">$(SakuraNativeFfiProfileDirectory)</SakuraRustCoreProfileDirectory>
    <SakuraRustCoreLibrary Condition="'$(SakuraRustCoreLibrary)'==''">$(SakuraNativeFfiLibrary)</SakuraRustCoreLibrary>
    <SakuraRustCoreStamp Condition="'$(SakuraRustCoreStamp)'==''">$(SakuraNativeFfiStamp)</SakuraRustCoreStamp>
    <SakuraRustCoreSystemLibraries Condition="'$(SakuraRustCoreSystemLibraries)'==''">$(SakuraNativeFfiSystemLibraries)</SakuraRustCoreSystemLibraries>
  </PropertyGroup>

  <Target Name="ValidateSakuraRustCoreBackend" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(SakuraUtf16BackendUpper)'!='CPP' And '$(SakuraUtf16BackendUpper)'!='RUST'"
           Text="SAKURA_UTF16_BACKEND must be exactly cpp or rust; got $(SAKURA_UTF16_BACKEND)." />
    <Error Condition="'$(SakuraOutputBackendUpper)'!='CPP' And '$(SakuraOutputBackendUpper)'!='RUST'"
           Text="SAKURA_OUTPUT_BACKEND must be exactly cpp or rust; got $(SAKURA_OUTPUT_BACKEND)." />
    <Error Condition="'$(SakuraUtf16BackendUpper)'=='RUST' And ('$(SakuraUtf16ProductionPackageUpper)'=='TRUE' Or '$(SakuraUtf16ProductionPackageUpper)'=='1' Or '$(SakuraUtf16ProductionPackageUpper)'=='ON' Or '$(SakuraUtf16ProductionPackageUpper)'=='YES')"
           Text="SAKURA_UTF16_PRODUCTION_PACKAGE=true requires SAKURA_UTF16_BACKEND=cpp" />
    <Error Condition="'$(SakuraOutputBackendUpper)'=='RUST' And ('$(SakuraOutputProductionPackageUpper)'=='TRUE' Or '$(SakuraOutputProductionPackageUpper)'=='1' Or '$(SakuraOutputProductionPackageUpper)'=='ON' Or '$(SakuraOutputProductionPackageUpper)'=='YES')"
           Text="SAKURA_OUTPUT_PRODUCTION_PACKAGE=true requires SAKURA_OUTPUT_BACKEND=cpp" />
    <Error Condition="('$(SakuraUtf16BenchmarkTelemetryUpper)'=='TRUE' Or '$(SakuraUtf16BenchmarkTelemetryUpper)'=='1' Or '$(SakuraUtf16BenchmarkTelemetryUpper)'=='ON' Or '$(SakuraUtf16BenchmarkTelemetryUpper)'=='YES') And ('$(SakuraUtf16ProductionPackageUpper)'=='TRUE' Or '$(SakuraUtf16ProductionPackageUpper)'=='1' Or '$(SakuraUtf16ProductionPackageUpper)'=='ON' Or '$(SakuraUtf16ProductionPackageUpper)'=='YES')"
           Text="SAKURA_UTF16_BENCHMARK_TELEMETRY is test-only and cannot package production." />
  </Target>

  <!-- Explicit diagnostic entry point. Normal backend/package validation must
       remain Cargo-free so a no-op or invalid-selection build fails only on its
       typed configuration contract. The actual build invokes Cargo naturally. -->
  <Target Name="PreflightSakuraNativeFfiCargo"
          DependsOnTargets="ValidateSakuraRustCoreBackend">
    <Exec Command="&quot;$(SakuraRustCoreCargo)&quot; --version"
          WorkingDirectory="$(SakuraRustCoreWorkspace)"
          StdOutEncoding="UTF-8"
          ConsoleToMSBuild="true" />
  </Target>

  <ItemGroup>
    <SakuraRustCoreSource Include="$(MSBuildThisFileFullPath)" />
    <SakuraRustCoreSource Include="$(SakuraNativeFfiManifest)" />
    <SakuraRustCoreSource Include="$(SakuraNativeFfiMemberManifest)" />
    <SakuraRustCoreSource Include="$(SakuraNativeFfiSimdManifest)" />
    <SakuraRustCoreSource Include="$(SakuraNativeFfiUnicodeManifest)" />
    <SakuraRustCoreSource Include="$([MSBuild]::NormalizePath('$(SakuraNativeFfiWorkspace)', 'Cargo.lock'))" />
    <SakuraRustCoreSource Include="$([MSBuild]::NormalizePath('$(SakuraNativeFfiWorkspace)', 'rust-toolchain.toml'))" />
    <SakuraRustCoreSource Include="$(SakuraNativeFfiWorkspace)\sakura_simd\src\**\*.rs" />
    <SakuraRustCoreSource Include="$(SakuraNativeFfiWorkspace)\sakura_unicode_core\src\**\*.rs" />
    <SakuraRustCoreSource Include="$(SakuraNativeFfiWorkspace)\sakura_native_ffi\src\**\*.rs" />
    <SakuraRustCoreSource Include="$(SakuraNativeFfiWorkspace)\sakura_simd\**\build.rs" />
    <SakuraRustCoreSource Include="$(SakuraNativeFfiWorkspace)\sakura_unicode_core\**\build.rs" />
    <SakuraRustCoreSource Include="$(SakuraNativeFfiWorkspace)\sakura_native_ffi\**\build.rs" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Native FFI is linked in both modes for candidate differential tests. -->
      <PreprocessorDefinitions>SAKURA_UTF16_RUST_CANDIDATE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- Exactly one Rust staticlib enters each native product/test link. -->
      <AdditionalDependencies>$(SakuraRustCoreLibrary);$(SakuraRustCoreSystemLibraries);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(SakuraUtf16BackendUpper)'=='RUST'">
    <ClCompile>
      <!-- Only an explicit Rust selection becomes the production provider. -->
      <PreprocessorDefinitions>SAKURA_UTF16_BACKEND_RUST;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(SakuraOutputBackendUpper)'=='RUST'">
    <ClCompile>
      <!-- Output authority selection is independent from UTF-16/SIMD dispatch. -->
      <PreprocessorDefinitions>SAKURA_OUTPUT_BACKEND_RUST;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(SakuraUtf16BenchmarkTelemetryUpper)'=='TRUE' Or '$(SakuraUtf16BenchmarkTelemetryUpper)'=='1' Or '$(SakuraUtf16BenchmarkTelemetryUpper)'=='ON' Or '$(SakuraUtf16BenchmarkTelemetryUpper)'=='YES'">
    <ClCompile>
      <PreprocessorDefinitions>SAKURA_UTF16_BENCHMARK_TELEMETRY;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <Target Name="PrepareSakuraNativeFfiIncrementalState"
          DependsOnTargets="ValidateSakuraRustCoreBackend">
    <!-- A stamp cannot represent a usable Cargo result after its library is removed. -->
    <Delete Files="$(SakuraRustCoreStamp)"
            Condition="Exists('$(SakuraRustCoreStamp)') And !Exists('$(SakuraRustCoreLibrary)')" />
  </Target>

  <Target Name="BuildSakuraNativeFfi"
          DependsOnTargets="PrepareSakuraNativeFfiIncrementalState"
          Inputs="@(SakuraRustCoreSource)"
          Outputs="$(SakuraRustCoreStamp)"
          BeforeTargets="Link">
    <Exec Command="&quot;$(SakuraRustCoreCargo)&quot; build --manifest-path &quot;$(SakuraNativeFfiManifest)&quot; --package sakura-native-ffi --locked --target x86_64-pc-windows-msvc --target-dir &quot;$(SakuraNativeFfiTargetDir)&quot; --profile $(SakuraNativeFfiCargoProfile)"
          WorkingDirectory="$(SakuraNativeFfiWorkspace)"
          StdOutEncoding="UTF-8"
          ConsoleToMSBuild="true" />
    <Error Condition="!Exists('$(SakuraRustCoreLibrary)')"
           Text="Cargo completed without producing the required sakura_native_ffi static library: $(SakuraRustCoreLibrary)" />
    <Touch Files="$(SakuraRustCoreStamp)" AlwaysCreate="true" />
  </Target>

  <!-- Compatibility entry point retained for existing build/test scripts. -->
  <Target Name="PrepareSakuraRustCoreIncrementalState"
          DependsOnTargets="PrepareSakuraNativeFfiIncrementalState" />

  <!-- Compatibility entry point retained for existing build/test scripts. -->
  <Target Name="BuildSakuraRustCore"
          DependsOnTargets="BuildSakuraNativeFfi" />
</Project>
