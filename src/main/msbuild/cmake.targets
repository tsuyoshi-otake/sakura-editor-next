<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <RcInclude Include="..\src\main\resources\sakura_rc.h" />
  </ItemGroup>
  <ItemGroup>
    <DarkModeLibInput Include="$(CMakeToolsSourceDir)\CMakeLists.txt" />
    <DarkModeLibInput Include="$(CMakeToolsSourceDir)\src\main\cmake\sakura.cmake" />
    <DarkModeLibInput Include="$(CMakeToolsSourceDir)\src\main\cmake\darkmodelib.cmake" />
    <DarkModeLibInput Include="$(CMakeToolsSourceDir)\tools\darkmodelib\CMakeLists.txt" />
    <DarkModeLibInput Include="$(CMakeToolsSourceDir)\tools\darkmodelib\darkmodelib.pc.in" />
    <DarkModeLibInput Include="$(CMakeToolsSourceDir)\externals\darkmodelib\include\*.*" />
    <DarkModeLibInput Include="$(CMakeToolsSourceDir)\externals\darkmodelib\src\*.*" />
  </ItemGroup>
  <PropertyGroup>
    <DarkModeLibOutput>$(CMakeToolsBuildDir)lib\darkmode.lib</DarkModeLibOutput>
    <DarkModeLibPackageConfig>$(CMakeToolsBuildDir)lib\pkgconfig\darkmodelib.pc</DarkModeLibPackageConfig>
    <DarkModeLibOutput Condition="'$(Configuration)'=='Debug'">$(CMakeToolsBuildDir)lib\Debug\darkmode.lib</DarkModeLibOutput>
    <DarkModeLibPackageConfig Condition="'$(Configuration)'=='Debug'">$(CMakeToolsBuildDir)lib\Debug\pkgconfig\darkmodelib.pc</DarkModeLibPackageConfig>
  </PropertyGroup>
  <Target Name="ConfigureCMakeTools" Condition="!Exists('$(CMakeToolsBuildDir)CMakeCache.txt')">
    <SetEnv name="VisualStudioVersion" value="$(VisualStudioVersion)" prefix="false" />
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' -A $(Platform) -B '$(CMakeToolsPath)' -S '$([MSBuild]::NormalizePath('$(CMakeToolsSourceDir)', '.'))' -DCMAKE_CONFIGURATION_TYPES='Debug;Release'&quot;" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" />
  </Target>
  <Target Name="GenerateVersionHeader" Inputs="..\src\main\cmake\version.h.in" Outputs="$(VersionHeader)" DependsOnTargets="ConfigureCMakeTools" BeforeTargets="ResourceCompile;ClCompile">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_version_header -- /nologo&quot;" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" />
  </Target>
  <Target Name="ConfigureHeaderMake" Condition="!Exists('$(HeaderMakeBuildDir)CMakeCache.txt')" DependsOnTargets="GenerateVersionHeader">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target configure_header_make -- /nologo&quot;" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" />
  </Target>
  <Target Name="GenerateHeaderMake" Condition="!Exists('$(HeaderMakeExe)')" DependsOnTargets="ConfigureHeaderMake">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(HeaderMakeBuildPath)' --config $(Configuration) -- /nologo &amp;&amp; &amp; '$(CMakeExe)' --install '$(HeaderMakeBuildPath)' --config $(Configuration)&quot;" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" />
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;&amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_header_make -- /nologo &gt; $null&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" />
  </Target>
  <Target Name="GenerateFuncCodeDefine" Inputs="@(FuncCodeRes)" Outputs="$(FuncCodeDefine)" DependsOnTargets="GenerateHeaderMake" BeforeTargets="ResourceCompile">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_funccode_define -- /nologo&quot;" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" />
  </Target>
  <Target Name="GenerateFuncCodeEnum" Inputs="@(FuncCodeRes)" Outputs="$(FuncCodeEnum)" DependsOnTargets="GenerateHeaderMake" BeforeTargets="ClCompile">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_funccode_enum -- /nologo&quot;" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" />
  </Target>
  <Target Name="GenerateDarkModeLib" Inputs="@(DarkModeLibInput)" Outputs="$(DarkModeLibOutput);$(DarkModeLibPackageConfig)" BeforeTargets="ClCompile">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_darkmodelib -- /nologo /nr:false&quot;" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" />
    <!-- CMake may determine that the nested target needs no compilation after a
         configuration-only input change. Close this target's timestamp contract. -->
    <Touch Files="$(DarkModeLibOutput);$(DarkModeLibPackageConfig)" />
  </Target>
  <Target Name="AppendCMakeToolsCleanTargetsForCMakeTools" BeforeTargets="CoreClean">
    <RemoveDir Directories="$(CMakeToolsBuildDir)" />
  </Target>
</Project>
