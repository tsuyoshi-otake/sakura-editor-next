<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <RcInclude Include="..\src\main\resources\sakura_rc.h" />
  </ItemGroup>
  <Target Name="ConfigureCMakeTools" Condition="!Exists('$(CMakeToolsBuildDir)CMakeCache.txt')">
    <SetEnv name="VisualStudioVersion" value="$(VisualStudioVersion)" prefix="false" />
    <!--
      VS 17.14's 64-bit Tracker.exe can terminate with 0xC0000374 on recent
      Windows 11 builds. CMake selects the 64-bit MSBuild host for its small
      generated projects even though the solution itself uses the stable
      32-bit host. Disable FileTracker and node reuse only for these generated
      children; the Sakura projects retain normal dependency tracking.
    -->
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;chcp 65001 &gt; NUL; [Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' -A $(Platform) -B '$(CMakeToolsPath)' -S '$([MSBuild]::NormalizePath('$(CMakeToolsSourceDir)', '.'))' -DCMAKE_CONFIGURATION_TYPES='Debug;Release' -DCMAKE_SYSTEM_VERSION='10.0.22621.0' -DCMAKE_TOOLCHAIN_FILE='$(VcpkgRoot)scripts/buildsystems/vcpkg.cmake' -DVCPKG_TARGET_TRIPLET=$(VcpkgTriplet)&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" StdErrEncoding="UTF-8" ConsoleToMSBuild="true" />
  </Target>
  <Target Name="GenerateVersionHeader" Inputs="..\src\main\cmake\version.h.in" Outputs="$(VersionHeader)" DependsOnTargets="ConfigureCMakeTools" BeforeTargets="ResourceCompile;ClCompile">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_version_header -- /nologo /nr:false /p:TrackFileAccess=false&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" />
  </Target>
  <Target Name="GenerateFuncCodeDefine" Inputs="@(FuncCodeRes)" Outputs="$(FuncCodeDefine)" DependsOnTargets="ConfigureCMakeTools" AfterTargets="GenerateVersionHeader" BeforeTargets="ResourceCompile">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_funccode_define -- /nologo /nr:false /p:TrackFileAccess=false&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" />
  </Target>
  <Target Name="GenerateFuncCodeEnum" Inputs="@(FuncCodeRes)" Outputs="$(FuncCodeEnum)" DependsOnTargets="ConfigureCMakeTools" AfterTargets="GenerateVersionHeader" BeforeTargets="ClCompile">
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command &quot;[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); &amp; '$(CMakeExe)' --build '$(CMakeToolsPath)' --config $(Configuration) --target generate_funccode_enum -- /nologo /nr:false /p:TrackFileAccess=false&quot;" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" StdOutEncoding="UTF-8" ConsoleToMSBuild="true" />
  </Target>
  <Target Name="GenerateSakuraExeManifest" Inputs="..\src\main\cmake\manifest.in;..\src\main\cmake\manifest.cmake" Outputs="$(CMakeToolsBuildDir)sakura.exe.manifest" DependsOnTargets="ConfigureCMakeTools" BeforeTargets="Link">
    <Exec Command="%22$(CMakeExe)%22 --build $(CMakeToolsPath) --config $(Configuration) --target generate_sakura_exe_manifest -- /nologo /nr:false /p:TrackFileAccess=false" EnvironmentVariables="$(CMakeBuildEnvironmentVariables)" />
  </Target>
  <Target Name="CleanCMakeToolsBuildDirOnExplicitRequest"
          Condition="'$(SakuraCleanCMakeToolsBuildDir)'=='true'"
          BeforeTargets="CoreClean">
    <RemoveDir Directories="$(CMakeToolsBuildDir)" />
  </Target>
</Project>
