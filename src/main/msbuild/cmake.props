<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="CMakeTools">
    <CMakeExe>$(VsInstallDir)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
    <CMakeToolsSourceDir>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..\..\..\'))</CMakeToolsSourceDir>
    <CMakeToolsBuildDir>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..\..\..\build\$(Platform)\CMakeTools\'))</CMakeToolsBuildDir>
    <CMakeToolsPath>$([MSBuild]::NormalizePath('$(CMakeToolsBuildDir)', '.'))</CMakeToolsPath>
    <VersionHeader>$(CMakeToolsBuildDir)version.h</VersionHeader>
    <FuncCodeDefine>$(CMakeToolsBuildDir)Funccode_define.h</FuncCodeDefine>
    <FuncCodeEnum>$(CMakeToolsBuildDir)Funccode_enum.h</FuncCodeEnum>
    <!-- A leaf project's Clean/Rebuild must not delete this shared generator
         workspace. Canonical full generator observations opt in explicitly. -->
    <SakuraCleanCMakeToolsBuildDir Condition="'$(SakuraCleanCMakeToolsBuildDir)'==''">false</SakuraCleanCMakeToolsBuildDir>
    <!-- Limit this workaround to generated CMake/MSBuild children. The regular
         project keeps FileTracker enabled for correct incremental compilation. -->
    <CMakeBuildEnvironmentVariables>TrackFileAccess=false;MSBUILDDISABLENODEREUSE=1</CMakeBuildEnvironmentVariables>
  </PropertyGroup>
  <ItemDefinitionGroup Label="CMakeTools">
    <ClCompile>
      <AdditionalIncludeDirectories>$(CMakeToolsBuildDir);$(CMakeToolsBuildDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(CMakeToolsBuildDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories Condition="'$(Configuration)'=='Debug'">$(CMakeToolsBuildDir)lib\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalLibraryDirectories Condition="'$(Configuration)'=='Release'">$(CMakeToolsBuildDir)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
</Project>
