{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sakura-editor-next.invalid/schema/test-inventory-v1.json",
  "title": "Sakura Editor NEXT stable test inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "source_revision",
    "source_dirty",
    "discovery",
    "test_count",
    "disabled_count",
    "guarantee_fingerprint",
    "tests"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "inventory_id": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "source_dirty": { "type": "boolean" },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "executable", "arguments", "executable_sha256"],
      "properties": {
        "framework": { "const": "googletest" },
        "executable": { "type": "string", "minLength": 1 },
        "arguments": { "const": ["--gtest_list_tests"] },
        "executable_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "test_count": { "type": "integer", "minimum": 1 },
    "disabled_count": { "type": "integer", "minimum": 0 },
    "guarantee_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "runtime", "status"],
        "properties": {
          "test_id": { "type": "string", "minLength": 1 },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runner_id", "selector"],
            "properties": {
              "runner_id": { "type": "string", "minLength": 1 },
              "selector": { "type": "string", "minLength": 1 }
            }
          },
          "status": { "enum": ["enabled", "disabled"] }
        }
      }
    }
  }
}
