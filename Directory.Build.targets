<Project>
  <PropertyGroup>
    <SakuraRepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</SakuraRepositoryRoot>
    <SakuraModulesManifest>$(SakuraRepositoryRoot)src\main\modules\modules.json</SakuraModulesManifest>
    <SakuraModulesStamp>$(SakuraRepositoryRoot)src\main\modules\generated\manifest.stamp.json</SakuraModulesStamp>
    <SakuraModulesCheckMarker>$(SakuraRepositoryRoot)build\.sakura\modules-check\verified.stamp</SakuraModulesCheckMarker>
    <SakuraModulesContextId Condition="'$(Platform)' == 'x64' and '$(Configuration)' == 'Debug'">msvc-x64-debug</SakuraModulesContextId>
    <SakuraModulesContextId Condition="'$(Platform)' == 'x64' and '$(Configuration)' == 'Release'">msvc-x64-release</SakuraModulesContextId>
    <SakuraModulesGeneratedProps Condition="'$(SakuraModulesContextId)' != ''">$(SakuraRepositoryRoot)src\main\modules\generated\msbuild\$(SakuraModulesContextId).props</SakuraModulesGeneratedProps>
    <!--
      This file is imported by every project MSBuild evaluates beneath the
      repository root, which is a wider set than the projects that consume a
      package context.  Managed helper projects build at Platform=AnyCPU and
      link nothing from the active package root, and CMake writes throwaway
      probe projects (VCTargetsPath, compiler identification) under build\ that
      run in jobs which deliberately never restore.  Package and projection
      validation therefore applies to this repository's own native projects.
    -->
    <SakuraGeneratedBuildRoot>$([MSBuild]::NormalizeDirectory('$(SakuraRepositoryRoot)', 'build'))</SakuraGeneratedBuildRoot>
    <SakuraGeneratedBuildRootUpper>$(SakuraGeneratedBuildRoot.ToUpperInvariant())</SakuraGeneratedBuildRootUpper>
    <SakuraProjectDirectoryNormalized>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</SakuraProjectDirectoryNormalized>
    <SakuraProjectDirectoryUpper>$(SakuraProjectDirectoryNormalized.ToUpperInvariant())</SakuraProjectDirectoryUpper>
    <SakuraOwnedNativeProject>false</SakuraOwnedNativeProject>
    <SakuraOwnedNativeProject Condition="'$(MSBuildProjectExtension)' == '.vcxproj' and !$(SakuraProjectDirectoryUpper.StartsWith('$(SakuraGeneratedBuildRootUpper)'))">true</SakuraOwnedNativeProject>
  </PropertyGroup>
  <!-- DesignTimeBuild reads only the committed projection. It must not launch
       Python, restore, code generation, staging, nested builds, or probes. -->
  <Import Project="$(SakuraModulesGeneratedProps)"
          Condition="'$(SakuraModulesGeneratedProps)' != '' and Exists('$(SakuraModulesGeneratedProps)')" />
  <ItemGroup>
    <SakuraBuildModelInputs Include="$(SakuraModulesManifest)" />
    <SakuraBuildModelInputs Include="$(SakuraRepositoryRoot)src\main\modules\schema-v3.json" />
    <SakuraBuildModelInputs Include="$(SakuraRepositoryRoot)src\main\modules\compile-profiles.json" />
    <SakuraBuildModelInputs Include="$(SakuraRepositoryRoot)tools\build\sakura_build.py" />
    <SakuraBuildModelInputs Include="$(SakuraRepositoryRoot)tools\build\sakura_build_lib\*.py" />
    <SakuraBuildModelInputs Include="$(SakuraRepositoryRoot)src\main\modules\generated\**\*" />
  </ItemGroup>

  <!-- Normal builds pay for the read-only hash check only after a model input changes. -->
  <Target Name="SakuraVerifyModuleGraph"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SakuraSkipModulesCheck)' != 'true'"
          Inputs="@(SakuraBuildModelInputs)"
          Outputs="$(SakuraModulesCheckMarker)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(SakuraModulesCheckMarker)'))" />
    <Exec Command="py -3 &quot;$(SakuraRepositoryRoot)tools\build\sakura_build.py&quot; generate --check"
          WorkingDirectory="$(SakuraRepositoryRoot)" />
    <Touch Files="$(SakuraModulesCheckMarker)" AlwaysCreate="true" />
  </Target>

  <!--
    Do not let vcpkg's imported targets turn a normal compile into a manifest
    restore.  The canonical driver owns restore and publishes a strict active
    root first; this target performs the cheap, read-only validation before any
    native scheduler starts.
  -->
  <Target Name="SakuraValidateExplicitPackageRestore"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SakuraSkipPackageRestoreValidation)' != 'true' and '$(SakuraOwnedNativeProject)' == 'true'">
    <Error Condition="'$(SakuraModulesContextId)' == ''"
           Text="No Sakura package context exists for Platform=$(Platform), Configuration=$(Configuration)." />
    <Error Condition="!Exists('$(SakuraPackageActiveProps)')"
           Text="Explicit Sakura package restore is missing: $(SakuraPackageActiveProps). Run: py -3 tools/build/sakura_build.py package restore sakura_app --context $(SakuraModulesContextId)" />
    <Exec Command="py -3 &quot;$(SakuraRepositoryRoot)tools\build\sakura_build.py&quot; package validate sakura_app --context $(SakuraModulesContextId)"
          WorkingDirectory="$(SakuraRepositoryRoot)" />
  </Target>

  <Target Name="SakuraValidateGeneratedModelForDesignTime"
          BeforeTargets="ClCompile"
          Condition="'$(DesignTimeBuild)' == 'true' and '$(SakuraSkipModulesCheck)' != 'true' and '$(SakuraOwnedNativeProject)' == 'true'">
    <Error Condition="'$(SakuraModulesContextId)' == ''"
           Text="No committed Sakura component projection exists for Platform=$(Platform), Configuration=$(Configuration)." />
    <Error Condition="!Exists('$(SakuraModulesGeneratedProps)')"
           Text="Committed Sakura component projection is missing: $(SakuraModulesGeneratedProps). Run: py -3 tools/build/sakura_build.py generate" />
    <Error Condition="'$(SakuraSemanticGraphHash)' == '' or '$(SakuraModulesGeneratorVersion)' == ''"
           Text="Committed Sakura component projection is invalid: $(SakuraModulesGeneratedProps). Run: py -3 tools/build/sakura_build.py generate" />
  </Target>

  <Import Project="$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.targets" />
</Project>
