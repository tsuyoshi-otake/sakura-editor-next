{
  "id": 20587143,
  "name": "Protect develop integration",
  "target": "branch",
  "source_type": "Repository",
  "source": "tsuyoshi-otake/sakura-editor-next",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/develop"
      ]
